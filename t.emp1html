<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0px;
      }
      ul{
            margin:0px;
            padding:0px;
        }
        li{
            display:inline-block;
            padding:5px;
            font-size:larger;

        }
        .submenu{
            display:none;
            position:absolute;
            background-color: aliceblue;
        }
        .menu:hover .submenu{
            dispaly:block;
        }
      .c {
        background-color: orange;
      }
      h3 {
        background-color: orange;
      }
      #h {
        position: sticky;
        top: 0px;
        background-color: orange;
        padding: 20px;
        display: flex;
        justify-content: space-between;
      }
      .row {
        background-color: silver;
        padding: 10px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        height: 100%;
      }
      .box {
        /* background-color: teal; */
        margin: 20px;
        padding: 20px;
        width: 300px;
        border: 5px solid orange;
        border-radius: 20px;
        background: linear-gradient(maroon, silver);
        box-shadow: 5px 5px 5px 5px grey;
        transition-property: transform;
        transition-duration: 0.5;
      }
      .box:hover{
height:200px;
      }

      .container {
        position: absolute;
        scroll-behavior: smooth;
        overflow: auto;
        top: 0px;
        left: 0px;
        right: 0px;
        bottom: 0px;
        height: 100%;
      }
      p {
        font-size: 12px;
        font-family: "verdana";
        font-weight: bold;
      }
      .header {
        background-image: url("cat1.jpg");
        background-size: cover;
        justify-content: center;
        align-items: end;
      }
      .caption {
        background-color: rgb(98, 0, 255);
        padding: 20px;
        opacity: 0.4;
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="container">
    <h1>Temp 6</h1>
    <!-- <h3 style="background-color: orange">My Application</h3> -->
    <!-- <h3 class="c">My Application</h3> -->
    <!-- <h3>My Application</h3> -->
     
    <div id="h">
      <h3>My Application</h3>
      <div>
        <a href="#home">Home</a>
        <a href="#projects">Projects</a>
        <a href="#">About</a>
        <a href="#">Services</a>
        <a href="#">Contact</a>
      </div>
    </div>
    <div class="row header" id="home">
      <div class="caption">
        <h1>Full Stack Developer</h1>
        <p>MERN | MERN | Java | Python</p>
      </div>
    </div>
    <div class="row" id="projects" >
      <div class="box">
        <h2>Project 1</h2>
        <p>This is my project 1</p>
        <a href="#">View Project</a>
      </div>
      <div class="box">
        <h2>Project 2</h2>
        <p>This is my project 2</p>
        <a href="#">View Project</a>
      </div>
      <div class="box">
        <h2>Project 3</h2>
        <p>This is my project 3</p>
        <a href="#">View Project</a>
      </div>
    </div>
    <div>
      <h3>@Copyright 2024. All rights reserved.</h3>
    </div>
  </div>
  </body>
</html>